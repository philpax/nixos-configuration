# Managed by ansible. Edit ../hermes.yml, not this file.
#
# The auth gate engages on any non-loopback bind and start_server fails closed
# without a registered provider, so the basic-auth credentials are mandatory.
[Unit]
Description=Hermes Agent web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory={{ workspace }}
Environment=HERMES_HOME={{ hermes_home }}
Environment=HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
Environment=HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ dashboard_password }}
ExecStart={{ state_root }}/hermes-agent/venv/bin/hermes dashboard \
  --host 0.0.0.0 --port {{ dashboard_port }} --no-open
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
