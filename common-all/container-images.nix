# Declarative container images for the machines running ananke.
#
# Three shapes, because the images come three ways:
#
#   mkOverlayImage  a base image plus patches — Nix writes the Dockerfile
#   mkSourceImage   a source tree with its own Dockerfile
#   mkPulledImage   an upstream image, pinned to a digest
#
# The first two tag the image with the hash of what it was built from, so an
# image and the config describing it cannot drift: change a pin and the tag
# changes, which is what `mkImageService` looks for when deciding whether to
# build. The third needs no tag of its own — a digest already names exactly
# one image, and ananke passes the reference through to the runtime as-is.
{ pkgs, lib }:
let
  # Renders one overlay into its Dockerfile lines. The context copies `src`
  # to `overlays/<index>`, so no store path leaks into the build context.
  overlayLines = index: overlay:
    let ctx = "overlays/${toString index}"; in
    if overlay.install or false then
      # A patch directory. It lands at the path its `install.sh` hardcodes
      # as PATCHDIR, then runs. These are idempotent and fail loud, so a
      # patch that no longer applies stops the build rather than producing
      # a quietly unpatched image.
      [
        "COPY ${ctx} ${overlay.dest}"
        "RUN bash ${overlay.dest}/install.sh"
      ]
    else
      [ "COPY ${ctx} ${overlay.dest}" ];

  # Builds `context` if `tag` is not already present. Podman owns the image
  # store directly, so builds and runs cannot drift across two engines.
  buildIfMissing = { name, tag, context, buildArgs ? { } }: ''
    if podman image exists ${tag}; then
      echo "image ${name}: ${tag} already built"
    else
      echo "image ${name}: building ${tag}"
      podman build --tag ${tag}${lib.concatStrings (lib.mapAttrsToList
        (arg: value: " --build-arg ${lib.escapeShellArg "${arg}=${value}"}")
        buildArgs)} ${context}
    fi
  '';

  # The store hash of a path, which is what every locally-built tag is
  # versioned by.
  storeHash = path: lib.head (lib.splitString "-" (baseNameOf path));
in
{
  # `base` is the image to build on, `overlays` the ordered list applied to
  # it. Each is `{ src; dest; install ? false; }` — `src` a path (file or
  # directory), `dest` where it lands in the image, and `install` whether to
  # run `dest/install.sh` afterwards.
  mkOverlayImage =
    { name
    , base
    , overlays ? [ ]
    }:
    let
      dockerfile = pkgs.writeText "${name}.Dockerfile" (
        lib.concatStringsSep "\n" (
          [
            "# Generated by common-all/container-images.nix. Do not edit on the host."
            "FROM ${base}"
          ]
          ++ lib.concatLists (lib.imap0 overlayLines overlays)
          ++ [ "" ]
        )
      );

      context = pkgs.runCommand "${name}-context" { } ''
        mkdir -p $out/overlays
        cp ${dockerfile} $out/Dockerfile
        ${lib.concatStringsSep "\n" (lib.imap0
          (index: overlay: ''
            cp -r ${overlay.src} $out/overlays/${toString index}
            chmod -R u+w $out/overlays/${toString index}
          '')
          overlays)}
      '';

      tag = "${name}:${storeHash context}";
    in
    {
      inherit name tag;
      buildCommand = buildIfMissing { inherit name tag context; };
    };

  # A source tree carrying its own Dockerfile — `src` is both the build
  # context and the recipe. Pin it with `fetchFromGitHub` rather than
  # pointing at a working tree, so the tag means something. `buildArgs`
  # become `--build-arg`s and are folded into the tag, so changing one
  # rebuilds; without any, the tag is the source's store hash alone.
  mkSourceImage =
    { name
    , src
    , buildArgs ? { }
    }:
    let
      version =
        if buildArgs == { } then storeHash src
        else builtins.substring 0 32
          (builtins.hashString "sha256" (builtins.toJSON { src = storeHash src; inherit buildArgs; }));
      tag = "${name}:${version}";
    in
    {
      inherit name tag;
      buildCommand = buildIfMissing { inherit name tag buildArgs; context = src; };
    };

  # An upstream image pinned to a digest. The digest is the reference —
  # there is no local tag to keep in sync, and no way for the image to
  # change without this file changing.
  mkPulledImage =
    { name
    , ref
    , digest
    }:
    let tag = "${ref}@${digest}"; in
    {
      inherit name tag;
      buildCommand = ''
        if podman image exists ${tag}; then
          echo "image ${name}: ${tag} already present"
        else
          echo "image ${name}: pulling ${tag}"
          podman pull ${tag}
        fi
      '';
    };

  # A oneshot that makes every image present before ananke wants them.
  # Ordered before ananke rather than required by it: a build that fails
  # should leave ananke running its other services, with the affected ones
  # failing to start and saying why.
  #
  # Build all images directly in Podman's store. Set `user` for a rootless
  # store; this must match the user that will later run the workload.
  mkImageService =
    { images
    , user ? null
    , runtimeUid ? null
    , environment ? { }
    , after ? [ "network-online.target" ]
    , wants ? [ ]
    , requires ? [ ]
    }:
    let
      runtimeUnit = lib.optional (runtimeUid != null) "user@${toString runtimeUid}.service";
    in
    {
      description = "Build the container images ananke serves with Podman";
      after = after ++ runtimeUnit;
      wants = wants ++ runtimeUnit;
      requires = requires ++ runtimeUnit;
      wantedBy = [ "multi-user.target" ];
      before = [ "ananke.service" ];
      # Rootless Podman shells out to newuidmap/newgidmap, which only work as
      # the setuid wrappers in /run/wrappers/bin — the shadow package's own
      # binaries lack the capabilities. `path` appends /bin to each entry, so
      # this names the wrapper root rather than /run/wrappers/bin.
      inherit environment;
      path = [ pkgs.podman pkgs.coreutils "/run/wrappers" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        # A cold run pulls multi-gigabyte bases and, for source images,
        # compiles them.
        TimeoutStartSec = "3h";
      } // lib.optionalAttrs (user != null) { User = user; };
      script = lib.concatStringsSep "\n" (
        [
          "set -euo pipefail"
          # `%U` is the system manager's UID (0), not the service user's UID.
          # Rootless Podman needs the runtime dir for the process identity.
        ]
        ++ lib.optional (user != null) "export XDG_RUNTIME_DIR=\"/run/user/$(${pkgs.coreutils}/bin/id -u)\""
        ++ map (image: image.buildCommand) images
      );
    };
}
