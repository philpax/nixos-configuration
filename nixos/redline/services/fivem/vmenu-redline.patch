         // Constants.
         private const string SETTINGS_PREFIX = "settings_";
 
+        // Force this server's preferred settings, once per client.
+        //
+        // vMenu's own default list only applies when a key is absent, and it
+        // only persists a toggle when the player explicitly picks Misc
+        // Settings > Save Personal Settings. So neither route reaches anyone
+        // who has already run vMenu anywhere. This overwrites the stored
+        // values a single time and then leaves the player alone.
+        //
+        // An explicit static constructor suppresses beforefieldinit, so the
+        // CLR guarantees this runs before the first read of any static member
+        // of this class — which is how the menus initialise themselves.
+        // Nothing can observe a setting before this has written it.
+        //
+        // Bump the marker key to re-apply after changing this list.
+        static UserDefaults()
+        {
+            if (!string.IsNullOrEmpty(GetResourceKvpString("redline_forced_defaults_v2")))
+            {
+                return;
+            }
+
+            // "True"/"False" matches bool.ToString(), which is what
+            // SetSavedSettingsBool writes and GetSettingsBool parses.
+            var forced = new Dictionary<string, bool>
+            {
+                // Police, and the whole wanted system, actually exist.
+                { "neverWanted", false },
+                // See each other on the map at any range.
+                { "miscShowPlayerBlips", true },
+                // Saved default loadout is equipped on join, not just respawn.
+                { "weaponLoadoutsSetLoadoutOnRespawn", true },
+                { "miscSpeedoKmh", true },
+                { "vehicleDisablePlaneTurbulence", true },
+                { "vehicleDisableHelicopterTurbulence", true },
+                { "pvEnableVehicleBlip", true },
+                // Off, so spawning a car doesn't delete the last one and you
+                // can leave vehicles around for each other.
+                { "vehicleSpawnerReplacePrevious", false },
+            };
+
+            foreach (var setting in forced)
+            {
+                SetResourceKvp(SETTINGS_PREFIX + setting.Key, setting.Value.ToString());
+            }
+
+            SetResourceKvp("redline_forced_defaults_v2", "1");
+        }
+
