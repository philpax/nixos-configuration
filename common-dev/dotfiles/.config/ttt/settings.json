{
  "version": 1,
  "theme": "13-tokyo-neon",
  "appearance": {
    "icons": "nerd-font",
    "scrollbarGlyphs": "blocks",
    "pointerShapes": true
  },
  "editor": {
    "autoClosing": {
      "brackets": false,
      "quotes": false,
      "skipClosing": true,
      "deletePairs": true,
      "inStrings": false,
      "plainText": false
    },
    "tabSize": 4,
    "insertSpaces": true,
    "wordWrap": true,
    "wordWrapColumn": 0,
    "diffMode": "split",
    "diffContext": "changes",
    "diffWordWrap": false,
    "diffHighContrast": false,
    "diffEmphasizeCollapsedRows": false,
    "diffSigns": false,
    "diffSignsColor": true,
    "diffGutterHighlight": true,
    "diffColorGutterNumbers": false,
    "diffScrollbarGitMarks": false,
    "lineNumbers": true,
    "selectionStyle": "background",
    "formatOnSave": true,
    "insertFinalNewline": true,
    "trimTrailingWhitespace": false,
    "focusOnOpen": false,
    "syntaxHighlight": true,
    "gitGutter": true,
    "autoDedent": true,
    "autoIndent": true,
    "gutterStyle": "compact",
    "borderStyle": "default",
    "bracketPairColorization": false,
    "showTrailingNewline": true,
    "menuBar": true,
    "transparentBackground": true,
    "grammars": [
      {
        "path": "grammars/ttt-lang-luau/syntaxes/luau.tmLanguage.json",
        "language": "Luau",
        "fileTypes": [
          "luau"
        ],
        "plugin": "ttt-lang-luau"
      }
    ],
    "saveAllOnQuit": false,
    "saveAllOnQuitExceptUnnamed": false
  },
  "quickOpen": {
    "showHidden": false,
    "showGitIgnored": false
  },
  "search": {
    "debounce": 350
  },
  "explorer": {
    "showHidden": true,
    "showGitIgnored": true,
    "gitStatusColors": true,
    "dimStagedGitColors": false,
    "autoReveal": false,
    "compactFolders": true
  },
  "sidebar": {
    "tabStyle": "label"
  },
  "git": {
    "fileView": "list"
  },
  "terminal": {
    "scrollback": 1000,
    "selectionStyle": "background",
    "ctrlVPastes": true,
    "padding_x": 1
  },
  "lsp": {
    "saveOnRename": false,
    "hoverDelay": 500
  },
  "autocomplete": {
    "enabled": true,
    "autoSuggest": true,
    "debounce": 150,
    "signatureHelp": true
  },
  "markdown": {
    "wrapWidth": 80
  },
  "image": {
    "protocol": "auto"
  },
  "plugins": {
    "enabled": true,
    "selectionStyle": "invert"
  },
  "welcome": {
    "recentFolders": true
  }
}
